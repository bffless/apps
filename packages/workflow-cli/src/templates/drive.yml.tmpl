name: Workflow drive

# The harness dispatches this (ADR-0006, spec 07 §Driven runs): a `repository_dispatch`
# with `client_payload: { mode: run|resume, run_id, harness_url, workflow?, inputs? }`
# sent by the harness's `POST /api/workflow/run/drive` rule through CE's github_api
# handler. `run` starts a workflow headless with --wait park; `resume` picks a parked
# run back up. Both exit 0 on a park — the run is waiting on a person, not failed.
on:
  repository_dispatch:
    types: [workflow-drive]

concurrency: { group: "drive-${{ github.event.client_payload.run_id }}", cancel-in-progress: false }

permissions: { contents: read }

jobs:
  drive:
    runs-on: ubuntu-latest
    # Two legs of `--timeout 60m` plus grace: one job can park and be resumed in
    # the same run (--wait park returns, then the resume leg follows again), and
    # the runner's own kill must not be how that normally ends. Being killed is
    # recoverable — the lease lapses after 60 s and the run stays adoptable —
    # but it loses the leg's exit code, so the ceiling sits above both legs.
    timeout-minutes: 130
    steps:
      - uses: actions/setup-node@v4
        with: { node-version: '20' }
      - run: npm install -g @bffless/workflow-headless@^1.2
      # Ask the Playwright the driver actually loaded, never a range restated here:
      # the driver resolves `playwright` for itself, so a literal in this file drifts
      # the day a driver release moves — and browsers of a revision the driver refuses
      # to run are worse than no cache at all. The resolved `version`, not the
      # manifest specifier, so a driver that loosens its pin cannot poison the key.
      - name: The Playwright version the driver loaded
        id: pw
        run: |
          root="$(npm root -g)/@bffless/workflow-headless"
          version="$(node -p "require(require.resolve('playwright/package.json', { paths: ['$root'] })).version")"
          echo "version=$version" >> "$GITHUB_OUTPUT"
      - uses: actions/cache@v4
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ runner.os }}-${{ steps.pw.outputs.version }}
      # The headless shell only: the driver launches chromium with no `channel`, so
      # Playwright >= 1.49 runs the shell and the full Chrome for Testing build would
      # be downloaded and never started. The apt system-dependency install is gone
      # too — every chromium library is already current on the runner image, and what
      # apt adds beyond it is CJK/Thai font coverage that reaches nothing but the
      # milestone screenshots. Restoring it is one flag. On a cache hit this step is
      # a no-op; on a miss it fetches the shell.
      - run: npx --yes playwright@${{ steps.pw.outputs.version }} install --only-shell chromium
      # Through the environment, never interpolated into `run:` — a JSON body is shell source otherwise.
      - name: Write the kickoff inputs
        env:
          WORKFLOW_INPUTS: ${{ toJSON(github.event.client_payload.inputs) }}
        run: printf '%s' "$WORKFLOW_INPUTS" > inputs.json
      - name: Drive
        env:
          MODE: ${{ github.event.client_payload.mode }}
          RUN_ID: ${{ github.event.client_payload.run_id }}
          HARNESS_URL: ${{ github.event.client_payload.harness_url }}
          TARGET: ${{ github.event.client_payload.workflow }}
          # The one secret (apps#588): an app token from Settings → App Tokens on the harness's
          # admin, minted with the scopes `workflow:read workflow:run workflow:files auth:session`.
          # The driver signs the browser in from it (CE's session exchange — `auth:session` is
          # the scope that gate checks) and sends it as Bearer on every /api/workflow/* call
          # (spec 10 D23). A repo secret, never dispatch payload; no email or password needed.
          WORKFLOW_APP_TOKEN: ${{ secrets.WORKFLOW_APP_TOKEN }}
        run: |
          if [ "$MODE" = "run" ]; then
            workflow-headless run "$HARNESS_URL" "$TARGET" --inputs inputs.json --run-id "$RUN_ID" --wait park --out output --timeout 60m
          else
            workflow-headless resume "$HARNESS_URL" "$RUN_ID" --out output --timeout 60m
          fi
      - uses: actions/upload-artifact@v4
        if: always()
        with: { name: "workflow-drive-${{ github.event.client_payload.run_id }}", path: output/, if-no-files-found: warn }
