targetUrl: pipeline
pipeline:
  name: __TITLE__
  description: "__DESCRIPTION__"
  steps:
    - id: __SEGMENT__
      name: __SEGMENT__
      handler: function_handler
      code: ./__SEGMENT__.fn.js
