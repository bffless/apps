{
  "name": "@bffless/workflow-lint",
  "version": "1.4.0",
  "private": false,
  "type": "module",
  "description": "Parser, schema validation, expression engine and static checks for BFFless Workflow YAML (spec: apps/workflow/docs/spec/)",
  "keywords": [
    "bffless",
    "workflow",
    "lint",
    "yaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bffless/apps.git",
    "directory": "packages/workflow-lint"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "workflow": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lint": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    },
    "./expressions": {
      "types": "./dist/expressions/index.d.ts",
      "default": "./dist/expressions/index.js"
    },
    "./definition": {
      "types": "./dist/model/definition.d.ts",
      "default": "./dist/model/definition.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.7"
  }
}
