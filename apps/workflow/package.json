    "highlight.js": "^11.12.0",
    "marked": "^16.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.9.0",
    "uplot": "^1.6.32",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bffless/workflow-script": "workspace:*",
    "@eslint/js": "^10.0.1",
