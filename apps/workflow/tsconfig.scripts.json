{
  /* The `hello` implementation's `script` step modules (03, Decision 13) —
     plain JavaScript, copied into the bundle verbatim by `scripts/stage-hello.mjs`
     with no build. Nothing type-checked or linted them before apps#375: a
     syntax error surfaced only in the e2e. This project checks them as
     JavaScript (`allowJs` + `checkJs`, strict) against the JSDoc `@type` import
     of `@bffless/workflow-script` each module already carries, and takes
     `src/hello-scripts.test.ts` — the unit test that imports them — with it.

     Same fence as `tsconfig.islands.json`: deliberately NOT referenced from
     `tsconfig.json`, so a bundle file can never fail the HARNESS build
     (`tsconfig.app.json` excludes the test for the same reason). The stager
     runs this project instead, so a broken script fails the bundle stage —
     the thing that is actually broken. */
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* JavaScript */
    "allowJs": true,
    "checkJs": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["hello/scripts", "src/hello-scripts.test.ts"]
}
