{
  /* The `hello` implementation's own sources: the two islands and the Vite
     config that bundles them. They are a *bundle*, not part of the harness —
     they never import from `src/`, and `tsconfig.app.json` deliberately does not
     see them — but they are still TypeScript that has to be trustworthy, so they
     get their own project rather than no type-checking at all.

     Deliberately NOT referenced from `tsconfig.json`: `pnpm --filter workflow
     build` runs `tsc -b` on that solution, and `deploy-workflow.yml` runs that
     build *before* staging the bundle. A reference here would mean a type error
     in an island source fails the HARNESS deploy — a coupling the plan forbids.
     `scripts/stage-hello.mjs` runs this project instead, so an island type error
     fails the bundle stage, which is the thing that is actually broken. */
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["hello"]
}
