{
  "name": "bffless-apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio:dev": "pnpm --filter studio dev",
    "studio:build": "pnpm --filter studio build",
    "studio:lint": "pnpm --filter studio lint",
    "studio:test": "pnpm --filter studio test:run",
    "handoff:dev": "pnpm --filter handoff dev",
    "handoff:build": "pnpm --filter handoff build",
    "handoff:lint": "pnpm --filter handoff lint",
    "handoff:typecheck:rules": "pnpm --filter handoff typecheck:rules",
    "handoff:test": "pnpm --filter handoff test:run",
    "reader:dev": "pnpm --filter reader dev",
    "reader:build": "pnpm --filter reader build",
    "reader:lint": "pnpm --filter reader lint",
    "reader:test": "pnpm --filter reader test:run",
    "recall:dev": "pnpm --filter recall dev",
    "recall:build": "pnpm --filter recall build",
    "recall:lint": "pnpm --filter recall lint",
    "recall:test": "pnpm --filter recall test:run",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "apps:check": "node scripts/check-app-conventions.mjs",
    "scripts:test": "node --test scripts/*.test.mjs",
    "sandcastle": "sh .sandcastle/prep.sh && npx tsx .sandcastle/main.ts",
    "store:dev": "pnpm --filter store dev",
    "store:build": "pnpm --filter store build",
    "store:assets": "node scripts/build-store-artifact.mjs --stage-only",
    "workflow-lint:build": "pnpm --filter @bffless/workflow-lint build",
    "workflow-lint:test": "pnpm --filter @bffless/workflow-lint test:run",
    "workflow-headless:build": "pnpm --filter @bffless/workflow-headless build",
    "workflow-headless:lint": "pnpm --filter @bffless/workflow-headless lint",
    "workflow-headless:test": "pnpm --filter @bffless/workflow-headless test:run",
    "workflow-headless:cli": "pnpm --filter @bffless/workflow-headless cli",
    "workflow-live:build": "pnpm --filter @bffless/workflow-live build",
    "workflow-live:lint": "pnpm --filter @bffless/workflow-live lint",
    "workflow-live:test": "pnpm --filter @bffless/workflow-live test:run",
    "workflow-live:walk": "pnpm --filter @bffless/workflow-live cli walk",
    "workflow:dev": "pnpm --filter workflow dev",
    "workflow:build": "pnpm --filter workflow build",
    "workflow:lint": "pnpm --filter workflow lint",
    "workflow:test": "pnpm --filter workflow test:run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "ffmpeg-static"
    ]
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@playwright/test": "1.61.1",
    "fflate": "^0.8.3"
  }
}
