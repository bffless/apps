# dependencies
node_modules
# pnpm's project-local store — created inside the Sandcastle sandbox (the worktree
# sits on a different filesystem than the agent's home, so pnpm puts its store here).
.pnpm-store/

# builds
dist
*.tsbuildinfo
.node_modules

# app-catalog bundle build output (scripts/build-app-bundle.mjs) — published via CI, not committed
dist-bundles/
.tmp-bundle-rulesets/

# test / coverage artifacts
coverage
playwright-report
test-results
screenshots
# ...except the app-catalog convention's committed screenshots (apps/<app>/catalog/screenshots/*.png)
!apps/*/catalog/screenshots/
!apps/*/catalog/screenshots/**

# local scratch
*.local
.studio-test.mp4
.bffless-backups/
.superpowers/
# impeccable skill's per-session hook cache (session-keyed, machine-local paths)
.impeccable/

# editor / OS
.DS_Store
.claude/settings.local.json
# git worktrees created by agent sessions — never commit (one was once
# committed as a stray gitlink, breaking clones with a phantom submodule)
.claude/worktrees/

# MCP config written per-run inside the Sandcastle sandbox — never commit.
# It is regenerated each run, would auto-load into a cloner's Claude Code against
# the maintainers' instance (#96), and committing it leaked a key before (#134).
.mcp.json

# store package build output — generated by pnpm store:build / scripts/build-store-artifact.mjs
store/dist/
store/public/assets/
store-dist/
.tmp-store/
# Astro's generated content-cache dir (also see repos/deployment-docs/.gitignore)
store/.astro/
